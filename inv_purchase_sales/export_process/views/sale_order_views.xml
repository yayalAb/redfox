<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_export_process" model="ir.ui.view">
        <field name="name">sale.order.form.export.process</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_export_process" type="object"
                    class="oe_stat_button" icon="fa-ship"
                    invisible="not export_process_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Export</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="export_process_id" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
