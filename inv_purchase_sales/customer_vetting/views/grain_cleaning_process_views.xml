<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grain_cleaning_process_kanban" model="ir.ui.view">
        <field name="name">grain.cleaning.process.kanban</field>
        <field name="model">grain.cleaning.process</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="company_id"/>
                <field name="stage_id"/>
                <field name="stage_technical_key"/>
                <progressbar field="stage_technical_key"
                    colors='{"draft": "info", "submitted": "warning", "reviewed": "200",
                             "approved": "success", "rejected": "danger", "cancel": "200"}'/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <div class="o_kanban_record_title fw-bold">
                                <field name="name" display="full"/>
                            </div>
                            <div class="text-muted small">
                                <field name="partner_id" display="full"/>
                            </div>
                            <div class="text-muted small">
                                <field name="date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_grain_cleaning_process_list" model="ir.ui.view">
        <field name="name">grain.cleaning.process.list</field>
        <field name="model">grain.cleaning.process</field>
        <field name="arch" type="xml">
            <list string="Grain cleaning"
                  decoration-muted="stage_technical_key == 'cancel'"
                  decoration-danger="stage_technical_key == 'rejected'"
                  decoration-success="stage_technical_key == 'approved'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="stage_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_grain_cleaning_process_form" model="ir.ui.view">
        <field name="name">grain.cleaning.process.form</field>
        <field name="model">grain.cleaning.process</field>
        <field name="arch" type="xml">
            <form string="Grain cleaning process">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight"
                            invisible="stage_technical_key != 'draft'"
                            groups="sales_team.group_sale_salesman"/>
                    <button name="action_review" string="Mark reviewed" type="object" class="oe_highlight"
                            invisible="stage_technical_key != 'submitted'"
                            groups="customer_vetting.group_customer_vetting_manager"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="stage_technical_key != 'reviewed'"
                            groups="customer_vetting.group_customer_vetting_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="stage_technical_key not in ('submitted', 'reviewed')"
                            groups="customer_vetting.group_customer_vetting_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="stage_technical_key in ('approved', 'rejected', 'cancel')"
                            groups="sales_team.group_sale_salesman"/>
                    <button name="action_reset_to_draft" string="Reset to draft" type="object"
                            invisible="stage_technical_key not in ('rejected', 'cancel')"
                            groups="customer_vetting.group_customer_vetting_manager"/>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': '0', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <field name="stage_technical_key" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not sale_order_id"
                                groups="sales_team.group_sale_salesman">
                            <field name="sale_order_id" widget="statinfo" string="Sales Order"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id" context="{'default_customer_rank': 1}"
                                   readonly="stage_technical_key != 'draft'"/>
                            <field name="date" readonly="stage_technical_key != 'draft'"/>
                            <field name="receipt_source_sale_order_id"
                                   invisible="not receipt_source_sale_order_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="stage_technical_key != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services" name="lines">
                            <field name="line_ids" nolabel="1" readonly="stage_technical_key != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="product_uom_category_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_grain_cleaning_process_search" model="ir.ui.view">
        <field name="name">grain.cleaning.process.search</field>
        <field name="model">grain.cleaning.process</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="stage_id"/>
                <filter name="filter_draft" string="Draft" domain="[('stage_technical_key', '=', 'draft')]"/>
                <filter name="filter_submitted" string="Submitted" domain="[('stage_technical_key', '=', 'submitted')]"/>
                <filter name="filter_reviewed" string="Reviewed" domain="[('stage_technical_key', '=', 'reviewed')]"/>
                <filter name="filter_approved" string="Approved" domain="[('stage_technical_key', '=', 'approved')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('stage_technical_key', '=', 'rejected')]"/>
                <filter name="filter_cancel" string="Cancelled" domain="[('stage_technical_key', '=', 'cancel')]"/>
                <separator/>
                <filter name="filter_open" string="Open"
                        domain="[('stage_technical_key', 'in', ('draft', 'submitted', 'reviewed'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_grain_cleaning_process" model="ir.actions.act_window">
        <field name="name">Grain cleaning</field>
        <field name="res_model">grain.cleaning.process</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="view_grain_cleaning_process_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a grain cleaning process.</p>
        </field>
    </record>

    <menuitem id="menu_grain_cleaning_process"
              name="Grain cleaning"
              parent="sale.sale_menu_root"
              action="action_grain_cleaning_process"
              sequence="26"/>
</odoo>
