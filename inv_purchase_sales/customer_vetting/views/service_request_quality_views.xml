<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_request_quality_list" model="ir.ui.view">
        <field name="name">service.request.quality.list</field>
        <field name="model">service.request.quality</field>
        <field name="arch" type="xml">
            <list string="Service request qualities" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_service_request_quality_form" model="ir.ui.view">
        <field name="name">service.request.quality.form</field>
        <field name="model">service.request.quality</field>
        <field name="arch" type="xml">
            <form string="Service request quality">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_service_request_quality" model="ir.actions.act_window">
        <field name="name">Service qualities</field>
        <field name="res_model">service.request.quality</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define quality grades for service requests and service products.</p>
        </field>
    </record>
    <menuitem id="menu_service_request_quality"
              name="Service qualities"
              parent="sale.sale_menu_root"
              action="action_service_request_quality"
              sequence="24"
              groups="customer_vetting.group_customer_vetting_manager"/>
</odoo>
