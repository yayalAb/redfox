<odoo>
    <record id="view_hr_expense_inherit_list_summary" model="ir.ui.view">
        <field name="name">hr.expense.list.summary.button</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_expenses_analysis_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_print_payment_request_summary"
                        string="Payment Request Summary"
                        type="object"
                        class="btn-secondary" />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
